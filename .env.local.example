# 🔐 SheeshaTonight Environment Configuration
# =========================================
# NEVER commit .env.local to version control!
# This file (.env.local.example) contains PLACEHOLDER values only
# Each developer should create their own .env.local with secure values

# 📦 DATABASE CONFIGURATION
# ========================
# Production: Use managed database service (AWS RDS, Azure SQL, etc.)
DATABASE_URL="postgresql://user:password@localhost:5432/sheeshatonight"

# 🔑 AUTHENTICATION & SECURITY
# ===========================
# CRITICAL: Generate strong 32+ character secret
# Never use the value shown here in production
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="generate-strong-32-character-secret-key-here"

# Security rounds for password hashing (recommend 10-12)
BCRYPT_ROUNDS=10

#  ENVIRONMENT & API
# ==================
NODE_ENV="development"
NEXT_PUBLIC_API_URL="http://localhost:3000"
API_SECRET_KEY="generate-another-32-character-secret-here"

#  EMAIL SERVICE (Optional)
# ===========================
# For production notifications/confirmations
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="alerts@sheeshatonight.com"
# SMTP_PASS="app-specific-password"

# PAYMENT PROCESSING (Optional)
# =============================
# For production checkout and settlements
# STRIPE_PUBLIC_KEY="pk_live_..."
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

#  FEATURE FLAGS
# ==============
NEXT_PUBLIC_AGE_VERIFICATION=true
NEXT_PUBLIC_ENABLE_VENDOR_PORTAL=true
NEXT_PUBLIC_ENABLE_ADMIN_PANEL=true

#  MONITORING & LOGGING (Optional)
# ==================================
# SENTRY_DSN="https://...@sentry.io/..."
# LOG_LEVEL="info"
